#include <stdio.h>
#include <string.h>

#define MAX_MUSICAS 15 // Capacidade minima exigida >= 10 (15 permite manter as 12 iniciais + testar novos cadastros)

struct Musica {
    int id;
    char titulo[60];
    char artista[50];
    char genero[30];
};

int main() {
    struct Musica playlist[MAX_MUSICAS] = {
        {1,  "Home",                        "BTS",                  "K-Pop"},
        {2,  "Lisboa",                      "Ana Vilela",           "MPB / Pop"},
        {3,  "Furacao de Ninar",            "Hungria Hip Hop",      "Rap Nacional"},
        {4,  "Poesia Acustica #2",          "Pineapple StormTV",    "Rap Acustico"},
        {5,  "Crack com Mussilon",          "Matue",                "Trap"},
        {6,  "Dimple",                      "BTS",                  "K-Pop"},
        {7,  "Bom e Novo",                  "Pile",                 "Gospel"},
        {8,  "Fake Love",                   "BTS",                  "K-Pop"},
        {9,  "Trem-Bala",                   "Ana Vilela",           "MPB / Pop"},
        {10, "Lembrancas",                  "Hungria Hip Hop",      "Rap Nacional"},
        {11, "Bencaos Que Nao Tem Fim",     "Isadora Pompeo",       "Gospel"}
    };

    int totalCadastradas = 11;
    int opcao = -1;

    do {
        printf("\n=========================================================\n");
        printf("                  MINHA PLAYLIST - CRUD                  \n");
        printf("=========================================================\n");
        printf("Musicas na playlist: %d / %d\n", totalCadastradas, MAX_MUSICAS);
        printf("---------------------------------------------------------\n");
        printf("1. Adicionar musica\n");
        printf("2. Listar todas as musicas\n");
        printf("3. Buscar musica por ID\n");
        printf("4. Atualizar musica\n");
        printf("5. Remover musica\n");
        printf("0. Sair\n");
        printf("---------------------------------------------------------\n");
        printf("Escolha uma opcao: ");

        if (scanf("%d", &opcao) != 1) {
            printf("\n[ERRO] Entrada invalida! Digite apenas numeros.\n");
            while (getchar() != '\n');
            opcao = -1;
            continue;
        }
        while (getchar() != '\n');

        switch (opcao) {
            case 1: { // CADASTRAR
                if (totalCadastradas >= MAX_MUSICAS) {
                    printf("\n[AVISO] A playlist atingiu o limite maximo de %d musicas!\n", MAX_MUSICAS);
                    break;
                }

                struct Musica nova;
                int idValido = 0;

                // Validacao do ID (positivo e unico)
                while (!idValido) {
                    printf("\nDigite o ID da musica (inteiro positivo): ");
                    if (scanf("%d", &nova.id) != 1 || nova.id <= 0) {
                        printf("[ERRO] ID invalido! Deve ser um numero maior que zero.\n");
                        while (getchar() != '\n');
                        continue;
                    }
                    while (getchar() != '\n');

                    int duplicado = 0;
                    for (int i = 0; i < totalCadastradas; i++) {
                        if (playlist[i].id == nova.id) {
                            duplicado = 1;
                            break;
                        }
                    }

                    if (duplicado) {
                        printf("[ERRO] Ja existe uma musica com o ID %d na playlist.\n", nova.id);
                    } else {
                        idValido = 1;
                    }
                }

                // Validacao do Titulo
                int tituloValido = 0;
                while (!tituloValido) {
                    printf("Digite o nome da musica: ");
                    fgets(nova.titulo, sizeof(nova.titulo), stdin);
                    nova.titulo[strcspn(nova.titulo, "\n")] = '\0';

                    if (strlen(nova.titulo) == 0) {
                        printf("[ERRO] O nome da musica nao pode ficar vazio.\n");
                    } else {
                        tituloValido = 1;
                    }
                }

                // Validacao do Artista
                int artistaValido = 0;
                while (!artistaValido) {
                    printf("Digite o nome do artista/banda: ");
                    fgets(nova.artista, sizeof(nova.artista), stdin);
                    nova.artista[strcspn(nova.artista, "\n")] = '\0';

                    if (strlen(nova.artista) == 0) {
                        printf("[ERRO] O nome do artista nao pode ficar vazio.\n");
                    } else {
                        artistaValido = 1;
                    }
                }

                // Validacao do Genero
                int generoValido = 0;
                while (!generoValido) {
                    printf("Digite o genero musical: ");
                    fgets(nova.genero, sizeof(nova.genero), stdin);
                    nova.genero[strcspn(nova.genero, "\n")] = '\0';

                    if (strlen(nova.genero) == 0) {
                        printf("[ERRO] O genero nao pode ficar vazio.\n");
                    } else {
                        generoValido = 1;
                    }
                }

                playlist[totalCadastradas] = nova;
                totalCadastradas++;
                printf("\n[SUCESSO] '%s' (%s) adicionada a playlist!\n", nova.titulo, nova.artista);
                break;
            }

            case 2: { // LISTAR
                if (totalCadastradas == 0) {
                    printf("\n[AVISO] A playlist esta vazia.\n");
                    break;
                }

                printf("\n============================= MINHA PLAYLIST =============================\n");
                printf("%-4s | %-26s | %-20s | %-15s\n", "ID", "MUSICA", "ARTISTA", "GENERO");
                printf("--------------------------------------------------------------------------\n");
                for (int i = 0; i < totalCadastradas; i++) {
                    printf("%-4d | %-26s | %-20s | %-15s\n",
                           playlist[i].id,
                           playlist[i].titulo,
                           playlist[i].artista,
                           playlist[i].genero);
                }
                printf("==========================================================================\n");
                break;
            }

            case 3: { // BUSCAR POR ID
                if (totalCadastradas == 0) {
                    printf("\n[AVISO] A playlist esta vazia.\n");
                    break;
                }

                int idBusca;
                printf("\nDigite o ID da musica que deseja buscar: ");
                if (scanf("%d", &idBusca) != 1 || idBusca <= 0) {
                    printf("[ERRO] ID invalido!\n");
                    while (getchar() != '\n');
                    break;
                }
                while (getchar() != '\n');

                int indice = -1;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (playlist[i].id == idBusca) {
                        indice = i;
                        break;
                    }
                }

                if (indice == -1) {
                    printf("\n[AVISO] Nenhuma musica encontrada com o ID %d.\n", idBusca);
                } else {
                    printf("\n--- Detalhes da Faixa ---\n");
                    printf("ID:      %d\n", playlist[indice].id);
                    printf("Musica:  %s\n", playlist[indice].titulo);
                    printf("Artista: %s\n", playlist[indice].artista);
                    printf("Genero:  %s\n", playlist[indice].genero);
                }
                break;
            }

            case 4: { // ATUALIZAR
                if (totalCadastradas == 0) {
                    printf("\n[AVISO] A playlist esta vazia. Nada para atualizar.\n");
                    break;
                }

                int idAtualizar;
                printf("\nDigite o ID da musica que deseja atualizar: ");
                if (scanf("%d", &idAtualizar) != 1 || idAtualizar <= 0) {
                    printf("[ERRO] ID invalido!\n");
                    while (getchar() != '\n');
                    break;
                }
                while (getchar() != '\n');

                int indice = -1;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (playlist[i].id == idAtualizar) {
                        indice = i;
                        break;
                    }
                }

                if (indice == -1) {
                    printf("\n[AVISO] Musica com ID %d nao encontrada.\n", idAtualizar);
                    break;
                }

                printf("\nEditando faixa: %s - %s (ID: %d)\n",
                       playlist[indice].titulo, playlist[indice].artista, playlist[indice].id);

                // Novo Titulo
                int tituloValido = 0;
                while (!tituloValido) {
                    printf("Novo nome da musica: ");
                    fgets(playlist[indice].titulo, sizeof(playlist[indice].titulo), stdin);
                    playlist[indice].titulo[strcspn(playlist[indice].titulo, "\n")] = '\0';

                    if (strlen(playlist[indice].titulo) == 0) {
                        printf("[ERRO] O nome da musica nao pode ficar vazio.\n");
                    } else {
                        tituloValido = 1;
                    }
                }

                // Novo Artista
                int artistaValido = 0;
                while (!artistaValido) {
                    printf("Novo artista/banda: ");
                    fgets(playlist[indice].artista, sizeof(playlist[indice].artista), stdin);
                    playlist[indice].artista[strcspn(playlist[indice].artista, "\n")] = '\0';

                    if (strlen(playlist[indice].artista) == 0) {
                        printf("[ERRO] O nome do artista nao pode ficar vazio.\n");
                    } else {
                        artistaValido = 1;
                    }
                }

                // Novo Genero
                int generoValido = 0;
                while (!generoValido) {
                    printf("Novo genero musical: ");
                    fgets(playlist[indice].genero, sizeof(playlist[indice].genero), stdin);
                    playlist[indice].genero[strcspn(playlist[indice].genero, "\n")] = '\0';

                    if (strlen(playlist[indice].genero) == 0) {
                        printf("[ERRO] O genero nao pode ficar vazio.\n");
                    } else {
                        generoValido = 1;
                    }
                }

                printf("\n[SUCESSO] Faixa atualizada com sucesso!\n");
                break;
            }

            case 5: { // REMOVER
                if (totalCadastradas == 0) {
                    printf("\n[AVISO] A playlist esta vazia. Nada para remover.\n");
                    break;
                }

                int idRemover;
                printf("\nDigite o ID da musica que deseja remover: ");
                if (scanf("%d", &idRemover) != 1 || idRemover <= 0) {
                    printf("[ERRO] ID invalido!\n");
                    while (getchar() != '\n');
                    break;
                }
                while (getchar() != '\n');

                int indice = -1;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (playlist[i].id == idRemover) {
                        indice = i;
                        break;
                    }
                }

                if (indice == -1) {
                    printf("\n[AVISO] Musica com ID %d nao encontrada.\n", idRemover);
                    break;
                }

                printf("\nRemovendo '%s' (%s)...\n", playlist[indice].titulo, playlist[indice].artista);

                for (int i = indice; i < totalCadastradas - 1; i++) {
                    playlist[i] = playlist[i + 1];
                }
                totalCadastradas--;

                printf("[SUCESSO] Musica removida da playlist!\n");
                break;
            }

            case 0:
                printf("\nFechando a playlist. Ate a proxima!\n");
                break;

            default:
                printf("\n[ERRO] Opcao invalida! Escolha um numero entre 0 e 5.\n");
                break;
        }

    } while (opcao != 0);

    return 0;
}